{
	"schemaVersion": 1,
	"id": "vanillina_enchantment-additions",
	"version": "${version}",
	"name": "Vanillina Enchantment Additions",
	"description": "Vanillina is a family of mods that adds small vanilla-feeling additions and patches to the base game.\n\nThis mod improves the enchanting system in a way that make the game less grindy and more relaxing.",
	"authors": [
		"vheart",
		"jjyk"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/vanillina_enchantment-additions/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"site.vheart.VanillinaEnchantmentAdditions"
		],
		"client": [
			"site.vheart.client.VanillinaEnchantmentAdditionsClient"
		]
	},
	"mixins": [
		"vanillina_enchantment-additions.mixins.json",
		{
			"config": "vanillina_enchantment-additions.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}